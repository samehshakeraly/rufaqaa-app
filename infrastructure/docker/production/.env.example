# Production env vars consumed by docker-compose.prod.yml.
# Copy to .env and fill in real values (do NOT commit .env).

# Used by postgres + backend
POSTGRES_PASSWORD=change-me

# REQUIRED in production. Generate: python -c "import secrets; print(secrets.token_urlsafe(64))"
# Left empty on purpose so the app refuses to boot until set.
SECRET_KEY=
JWT_SECRET_KEY=

# MyFatoorah payment webhook HMAC secret
# REQUIRED in production — the app refuses to boot if unset.
MYFATOORAH_WEBHOOK_SECRET=

# Used by CORS + the SPA's API base
PUBLIC_HOST=rufaqaa.example.com
