# Production env vars consumed by docker-compose.prod.yml.
# Copy to .env and fill in real values (do NOT commit .env).

# Used by postgres + backend
POSTGRES_PASSWORD=change-me

# Secrets — generate with:  python -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=change-me-please-at-least-64-chars
JWT_SECRET_KEY=change-me-please-at-least-64-chars

# Used by CORS + the SPA's API base
PUBLIC_HOST=rufaqaa.example.com
