# Production env vars consumed by docker-compose.prod.yml.
# Copy to .env and fill in real values (do NOT commit .env).

# Used by postgres + backend
POSTGRES_PASSWORD=change-me

# Used by CORS, the SPA's API base, transactional-email links and the
# MyFatoorah payment callback URLs (APP_BASE_URL is derived as
# https://$PUBLIC_HOST in the compose file).
PUBLIC_HOST=rufaqaa.example.com

# ── Required secrets ────────────────────────────────────────────────
# The backend startup guard refuses to boot in production when any of
# these is empty or still at its development default. They are left
# EMPTY here on purpose: an un-edited .env must FAIL the guard rather
# than boot on a placeholder. Generate the signing keys with:
#   python -c "import secrets; print(secrets.token_urlsafe(64))"

# REQUIRED in production
SECRET_KEY=
# REQUIRED in production
JWT_SECRET_KEY=
# REQUIRED in production
S3_ACCESS_KEY=
# REQUIRED in production
S3_SECRET_KEY=
# REQUIRED in production
MYFATOORAH_API_KEY=
# REQUIRED in production
MYFATOORAH_WEBHOOK_SECRET=

# ── Object storage (external S3 / MinIO) ────────────────────────────
# No storage service runs in the prod stack, so point this at your
# provider. The commented overrides below fall back to the app defaults
# shown when left unset.

# REQUIRED in production — e.g. https://s3.eu-central-1.amazonaws.com
S3_ENDPOINT=
# Optional overrides (defaults match the app):
# S3_PUBLIC_ENDPOINT=
# S3_BUCKET_PRIVATE=rufaqaa-private
# S3_BUCKET_PUBLIC=rufaqaa-public
# S3_REGION=us-east-1

# ── Payment gateway (MyFatoorah) ────────────────────────────────────
# REQUIRED in production — your LIVE base URL, NOT the apitest sandbox
MYFATOORAH_API_URL=
