# ═══════════════════════════════════════════════════════════════
# Rufaqaa Backend — Environment Variables Template
# ═══════════════════════════════════════════════════════════════
#
# Copy to `.env` (next to this file) and adjust for your environment:
#   cp .env.example .env
#
# Values below are the development defaults baked into
# app/core/config.py. They are SAFE FOR LOCAL DEV ONLY.
#
# ⚠️  NEVER commit the real `.env` to Git.
# ⚠️  When ENVIRONMENT is not "development", the app refuses to boot
#     unless every secret below is set to a strong, unique value
#     (see the startup guard in app/core/config.py).
# ═══════════════════════════════════════════════════════════════

# ─── General ─────────────────────────────────────────────────
ENVIRONMENT=development
DEBUG=true
TZ=Asia/Kuwait
APP_NAME=Rufaqaa API
API_V1_PREFIX=/api/v1

# ─── PostgreSQL ──────────────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://rufaqaa:rufaqaa_dev_password@localhost:5432/rufaqaa
DB_ECHO=false
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20

# ─── Redis / Celery ──────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# ─── Security ────────────────────────────────────────────────
# ⚠️  PRODUCTION MUST OVERRIDE SECRET_KEY AND JWT_SECRET_KEY.
# The value below is the well-known insecure default; outside
# development the startup guard rejects it (an attacker who knows the
# default JWT signing key can forge valid tokens). Generate a strong,
# unique value for each:
#   python -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=development_only_change_in_production
JWT_SECRET_KEY=development_only_change_in_production
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7
BCRYPT_ROUNDS=12

# ─── Login throttling ────────────────────────────────────────
LOGIN_MAX_FAILED_ATTEMPTS=5
LOGIN_LOCKOUT_MINUTES=15

# ─── CORS ────────────────────────────────────────────────────
# Comma-separated exact origins allowed to call the API.
CORS_ORIGINS=http://localhost:3000,http://localhost:5173
# OR-ed with CORS_ORIGINS. Default matches any localhost/127.0.0.1
# port for local dev. Set empty in production to use the explicit
# allow-list only.
CORS_ORIGIN_REGEX=https?://(localhost|127\.0\.0\.1)(:\d+)?

# ─── Rate Limiting ───────────────────────────────────────────
RATE_LIMIT_PUBLIC=60
RATE_LIMIT_AUTHENTICATED=300
RATE_LIMIT_ENABLED=true
# "memory" (per-process, fine for dev) or "redis" (shared across
# workers, recommended in production).
RATE_LIMIT_BACKEND=memory

# ─── Logging ─────────────────────────────────────────────────
LOG_LEVEL=INFO
LOG_FORMAT=json

# ─── MyFatoorah (Payment Gateway) ────────────────────────────
# Get your keys from https://portal.myfatoorah.com
MYFATOORAH_API_URL=https://apitest.myfatoorah.com
MYFATOORAH_API_KEY=
# ⚠️  PRODUCTION MUST SET MYFATOORAH_WEBHOOK_SECRET. It signs/verifies
# incoming webhook callbacks; the startup guard rejects an empty value
# outside development. Leave empty for local dev.
MYFATOORAH_WEBHOOK_SECRET=

# ─── MinIO / S3 ──────────────────────────────────────────────
S3_ENDPOINT=http://localhost:9000
# Browser-facing S3 origin for presigned URLs; empty = no rewrite.
S3_PUBLIC_ENDPOINT=
S3_ACCESS_KEY=rufaqaa_admin
S3_SECRET_KEY=rufaqaa_dev_secret_change_me
S3_BUCKET_PRIVATE=rufaqaa-private
S3_BUCKET_PUBLIC=rufaqaa-public
S3_REGION=us-east-1
UPLOAD_MAX_BYTES=10485760

# ─── Email (SMTP) ────────────────────────────────────────────
# Defaults target the MailHog dev container; in production point these
# at a real relay and flip EMAIL_ENABLED to true.
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
SMTP_TLS=false
EMAIL_FROM=noreply@rufaqaa.app
EMAIL_FROM_NAME=رفقاء
EMAIL_ENABLED=false
DEFAULT_LOCALE=ar

# Base URL the SPA is served at — used for absolute links in emails
# and MyFatoorah success/failure redirects.
APP_BASE_URL=http://localhost:5173

# ─── Error reporting (Sentry) ────────────────────────────────
# Leave SENTRY_DSN empty to disable.
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.0
SENTRY_RELEASE=
