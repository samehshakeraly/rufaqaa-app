# ═══════════════════════════════════════════════════════════════
# EditorConfig — Rufaqaa Platform
# https://editorconfig.org
# ═══════════════════════════════════════════════════════════════

root = true

# ─── Default ─────────────────────────────────────────────────
[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4
max_line_length = 100

# ─── Python ──────────────────────────────────────────────────
[*.py]
indent_size = 4
max_line_length = 100

# ─── JavaScript / TypeScript / JSX / TSX ─────────────────────
[*.{js,jsx,ts,tsx,mjs,cjs}]
indent_size = 2
max_line_length = 100

# ─── JSON ────────────────────────────────────────────────────
[*.{json,jsonc}]
indent_size = 2

# ─── YAML ────────────────────────────────────────────────────
[*.{yml,yaml}]
indent_size = 2

# ─── Markdown ────────────────────────────────────────────────
[*.{md,mdx}]
indent_size = 2
trim_trailing_whitespace = false
max_line_length = 0

# ─── SQL ─────────────────────────────────────────────────────
[*.sql]
indent_size = 2
max_line_length = 120

# ─── HTML / CSS / SCSS ───────────────────────────────────────
[*.{html,css,scss,sass}]
indent_size = 2

# ─── Shell scripts ───────────────────────────────────────────
[*.sh]
indent_size = 2
end_of_line = lf

# ─── Makefile (requires tabs) ────────────────────────────────
[{Makefile,*.mk}]
indent_style = tab

# ─── Configuration files ─────────────────────────────────────
[{.gitattributes,.gitignore,.gitmodules}]
indent_size = 2

[*.toml]
indent_size = 2
