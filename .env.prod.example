# ═══════════════════════════════════════════════════════════════
# Rufaqaa Platform — Production / Staging environment template
# ═══════════════════════════════════════════════════════════════
#
# Copy to `.env` on the VPS and replace every REPLACE_WITH_* placeholder:
#   cp .env.prod.example .env
#
# This file is committed as a TEMPLATE — it contains placeholders ONLY,
# never real secrets. The live `.env` is git-ignored.
#
# Outside `development` the backend runs a boot-time secrets guard
# (app.core.startup_checks.assert_production_secrets): it refuses to start
# if any production-critical secret is empty OR still equal to its bundled
# development default. The guarded fields are SECRET_KEY, JWT_SECRET_KEY,
# FIELD_ENCRYPTION_KEY, S3_ACCESS_KEY, S3_SECRET_KEY, MYFATOORAH_API_KEY
# and MYFATOORAH_WEBHOOK_SECRET — so all of those MUST be changed below.
# ═══════════════════════════════════════════════════════════════

# ─── Deployment identity ─────────────────────────────────────
# Public hostname for the demo. Drives Caddy's TLS, the Vite build arg and
# the MinIO public origin. Point this DNS A/AAAA record at the VPS.
DOMAIN=demo.rufaqaa.app

# Must be `staging` or `production` so the secrets guard above is ACTIVE.
# (Leave it `development` and the guard is a no-op — do not do that here.)
ENVIRONMENT=staging
DEBUG=false
TZ=Asia/Kuwait

# ─── Core application secrets (guarded) ──────────────────────
# Generate a long random value, e.g.:
#   python -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=REPLACE_WITH_A_LONG_RANDOM_64_CHAR_SECRET
JWT_SECRET_KEY=REPLACE_WITH_A_DIFFERENT_LONG_RANDOM_64_CHAR_SECRET
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# Fernet key for field-level encryption of national_id (and other PII) at
# rest. Generate it ONCE and keep it STABLE for the life of the database:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# ⚠️  Rotating this key makes every EXISTING encrypted national_id value
#     undecryptable — there is no second key / MultiFernet fallback. Back it
#     up somewhere safe and never change it on a database that already holds
#     encrypted data.
FIELD_ENCRYPTION_KEY=REPLACE_WITH_A_GENERATED_FERNET_KEY

# ─── PostgreSQL ──────────────────────────────────────────────
# POSTGRES_* configure the postgres container; DATABASE_URL is what the app
# connects with. docker-compose.prod.yml derives the in-container
# DATABASE_URL from POSTGRES_* (host `postgres`); the value here is the same
# string, kept for clarity / non-Compose use.
POSTGRES_USER=rufaqaa
POSTGRES_PASSWORD=REPLACE_WITH_A_STRONG_DB_PASSWORD
POSTGRES_DB=rufaqaa
DATABASE_URL=postgresql+asyncpg://rufaqaa:REPLACE_WITH_A_STRONG_DB_PASSWORD@postgres:5432/rufaqaa

# ─── Redis / Celery ──────────────────────────────────────────
# Hosts resolve on the internal Compose network (`redis`).
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/2

# ─── MinIO / S3 (guarded: S3_ACCESS_KEY, S3_SECRET_KEY) ───────
# MINIO_ROOT_USER/PASSWORD are MinIO's credentials; S3_ACCESS_KEY/S3_SECRET_KEY
# are how the backend authenticates to it — they MUST be identical pairs.
MINIO_ROOT_USER=rufaqaa_demo_admin
MINIO_ROOT_PASSWORD=REPLACE_WITH_A_STRONG_MINIO_PASSWORD
S3_ACCESS_KEY=rufaqaa_demo_admin
S3_SECRET_KEY=REPLACE_WITH_A_STRONG_MINIO_PASSWORD

# Internal endpoint the backend signs against, and the browser-facing origin
# the presigned URLs are rewritten to (served by Caddy at /media). Compose
# derives both from DOMAIN; shown here for completeness. S3_PUBLIC_ENDPOINT
# MUST stay in sync with DOMAIN.
S3_ENDPOINT=http://minio:9000
S3_PUBLIC_ENDPOINT=https://demo.rufaqaa.app/media
S3_BUCKET_PRIVATE=rufaqaa-private
S3_BUCKET_PUBLIC=rufaqaa-public
S3_REGION=us-east-1

# ─── MyFatoorah (payment gateway — SANDBOX) ──────────────────
# Sandbox base URL; get the sandbox keys from https://portal.myfatoorah.com.
# Both keys are guarded (their dev default is empty), so they must be set for
# the app to boot — even if the demo never takes a real payment.
MYFATOORAH_API_URL=https://apitest.myfatoorah.com
MYFATOORAH_API_KEY=REPLACE_WITH_MYFATOORAH_SANDBOX_API_KEY
MYFATOORAH_WEBHOOK_SECRET=REPLACE_WITH_MYFATOORAH_SANDBOX_WEBHOOK_SECRET

# ─── Frontend (Vite) ─────────────────────────────────────────
# Inlined into the SPA bundle at BUILD time by docker-compose.prod.yml (build
# arg, derived from DOMAIN). Listed here for clarity — must equal
# https://<DOMAIN>/api/v1.
VITE_API_URL=https://demo.rufaqaa.app/api/v1

# ─── Recommended production hardening ────────────────────────
# Same-origin in this topology (SPA and API both served from <DOMAIN>), so
# CORS is effectively unused; pin it to the domain and drop the dev
# localhost regex anyway.
CORS_ORIGINS=https://demo.rufaqaa.app
CORS_ORIGIN_REGEX=
# Public base URL used to build MyFatoorah redirects and email links.
APP_BASE_URL=https://demo.rufaqaa.app
# Shared, multi-worker-safe rate limiting.
RATE_LIMIT_BACKEND=redis
LOG_LEVEL=INFO
LOG_FORMAT=json
# Transactional email is off by default; set a real relay + EMAIL_ENABLED=true
# to turn it on.
EMAIL_ENABLED=false
