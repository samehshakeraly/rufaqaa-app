# ═══════════════════════════════════════════════════════════════
# Rufaqaa Platform — Environment Variables Template
# ═══════════════════════════════════════════════════════════════
#
# Copy this file to `.env` and adjust values for your environment:
#   cp .env.example .env
#
# ⚠️  NEVER commit the actual `.env` file to Git
# ⚠️  CHANGE ALL secrets before deploying to production
# ═══════════════════════════════════════════════════════════════

# ─── General ─────────────────────────────────────────────────
ENVIRONMENT=development
DEBUG=true
TZ=Asia/Kuwait

# ─── PostgreSQL ──────────────────────────────────────────────
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=rufaqaa
POSTGRES_PASSWORD=rufaqaa_dev_password
POSTGRES_DB=rufaqaa
DATABASE_URL=postgresql+asyncpg://rufaqaa:rufaqaa_dev_password@localhost:5432/rufaqaa

# ─── Redis ───────────────────────────────────────────────────
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# ─── MinIO / S3 ──────────────────────────────────────────────
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001
MINIO_ROOT_USER=rufaqaa_admin
MINIO_ROOT_PASSWORD=rufaqaa_dev_secret_change_me

S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=rufaqaa_admin
S3_SECRET_KEY=rufaqaa_dev_secret_change_me
S3_BUCKET_PRIVATE=rufaqaa-private
S3_BUCKET_PUBLIC=rufaqaa-public
S3_REGION=us-east-1

# ─── Adminer ─────────────────────────────────────────────────
ADMINER_PORT=8080

# ─── MailHog (Development Email) ─────────────────────────────
MAILHOG_SMTP_PORT=1025
MAILHOG_WEB_PORT=8025
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
SMTP_TLS=false
EMAIL_FROM=noreply@rufaqaa.app
EMAIL_FROM_NAME=رفقاء

# ─── Security ────────────────────────────────────────────────
# CHANGE THESE BEFORE DEPLOYING ANYWHERE
SECRET_KEY=development_only_change_in_production_minimum_64_chars_xxxxxxxxxxxxxxxxx
JWT_SECRET_KEY=development_only_change_in_production_minimum_64_chars_xxxxxxxxxxxxxxxxx
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

ENCRYPTION_KEY=development_only_change_in_production_32_bytes_base64_encoded_xxxxxxxx

# Password hashing
BCRYPT_ROUNDS=12

# ─── CORS ────────────────────────────────────────────────────
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# ─── Rate Limiting ───────────────────────────────────────────
RATE_LIMIT_PUBLIC=60        # per minute
RATE_LIMIT_AUTHENTICATED=300
RATE_LIMIT_ADMIN=1000
# Pick "memory" (per-process, fine for dev) or "redis" (shared across
# workers, recommended in production).
RATE_LIMIT_BACKEND=memory

# ─── MyFatoorah (Payment Gateway) ────────────────────────────
# Get your keys from https://portal.myfatoorah.com
MYFATOORAH_API_URL=https://apitest.myfatoorah.com    # Sandbox
# MYFATOORAH_API_URL=https://api.myfatoorah.com      # Production
MYFATOORAH_API_KEY=your_myfatoorah_api_key_here
MYFATOORAH_WEBHOOK_SECRET=your_webhook_secret_here
# Public base URL where the SPA is served — used to build the
# success / failure redirects MyFatoorah sends the donor to after
# they pay. See docs/integrations/myfatoorah.md.
APP_BASE_URL=http://localhost:5173

# ─── Anthropic (Claude AI / MCP) ─────────────────────────────
ANTHROPIC_API_KEY=

# ─── Error reporting (Sentry) ────────────────────────────────
# Leave SENTRY_DSN empty to disable. With a DSN set, the FastAPI
# / SQLAlchemy / Celery integrations send exceptions to Sentry.
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.0
SENTRY_RELEASE=

# ─── Logging ─────────────────────────────────────────────────
LOG_LEVEL=INFO
LOG_FORMAT=json    # json or text

# ─── Backend ─────────────────────────────────────────────────
BACKEND_PORT=8000

# ─── Frontend ────────────────────────────────────────────────
FRONTEND_PORT=3000

# ─── Frontend (Vite) ─────────────────────────────────────────
VITE_API_URL=http://localhost:8000
VITE_APP_NAME=رفقاء
VITE_DEFAULT_LANGUAGE=ar
VITE_DEFAULT_CURRENCY=KWD

# ─── Feature Flags ───────────────────────────────────────────
FEATURE_MCP_ENABLED=true
FEATURE_WHATSAPP_ENABLED=false
FEATURE_AI_MODERATION_ENABLED=false
