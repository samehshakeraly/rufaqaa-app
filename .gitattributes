# ═══════════════════════════════════════════════════════════════
# Git Attributes — Rufaqaa Platform
# ═══════════════════════════════════════════════════════════════

# Default behavior — normalize to LF
* text=auto eol=lf

# ─── Source code ─────────────────────────────────────────────
*.py text eol=lf
*.js text eol=lf
*.jsx text eol=lf
*.ts text eol=lf
*.tsx text eol=lf
*.json text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.toml text eol=lf
*.sql text eol=lf
*.html text eol=lf
*.css text eol=lf
*.scss text eol=lf

# ─── Documentation ───────────────────────────────────────────
*.md text eol=lf
*.mdx text eol=lf
*.txt text eol=lf

# ─── Shell scripts (always LF) ───────────────────────────────
*.sh text eol=lf
*.bash text eol=lf

# ─── Windows scripts (always CRLF) ───────────────────────────
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

# ─── Binary files (no diff) ──────────────────────────────────
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.webp binary
*.svg text eol=lf
*.pdf binary
*.zip binary
*.tar.gz binary
*.ttf binary
*.otf binary
*.woff binary
*.woff2 binary
*.mp3 binary
*.mp4 binary
*.mov binary

# ─── Linguist overrides (GitHub language detection) ──────────
docs/* linguist-documentation
*.sql linguist-detectable=true
*.ipynb linguist-detectable=false

# ─── Files to exclude from archive (e.g., GitHub release zip) ─
.gitattributes export-ignore
.gitignore export-ignore
.editorconfig export-ignore
.github/ export-ignore
tests/ export-ignore
